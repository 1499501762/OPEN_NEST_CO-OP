<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenNestModMenu.API</AssemblyName>
    <RootNamespace>OpenNestModMenu.API</RootNamespace>
    <Version>0.1.0</Version>
    <!--
      OpenNestModMenu 契约程序集（纯 .NET：无 Unity / Il2CppInterop / 游戏程序集依赖）。
      用途：第三方模组只引用本 dll（**软依赖**）即可把自己的设置页注册进模组菜单——
            未安装 OpenNestModMenu 时，注册只是进内存注册表（ModMenuHost.IsHostAvailable=false），
            不影响第三方模组自身加载。BepInEx 与 MelonLoader 双端可用同一份 dll。
      设计文档：docs/MOD_MENU.md
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 允许 ModMenu 本体把「宿主已就绪」标记写进注册表 -->
    <InternalsVisibleTo Include="OpenNestModMenu" />
    <InternalsVisibleTo Include="OpenNestModMenu.MelonMod" />
  </ItemGroup>

</Project>
